{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "oxossi-malta",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "vars": {
    "PUBLIC_SQUIDEX_ASSETS": "/api/assets/oxossi-malta/",
    "PUBLIC_SQUIDEX_ENVIRONMENT": "https://cloud.squidex.io",
    "SQUIDEX_APP_NAME": "oxossi-malta",
    "SQUIDEX_CLIENT_ID": "oxossi-malta:read-only"
  }
}
