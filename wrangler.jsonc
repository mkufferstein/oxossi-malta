{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "oxossi-malta",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  }
}
