{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "oxossi-malta",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false
    }
  },
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "capoeira-malta-content-cache"
    }
  ],
  "vars": {
    "CONTENT_CACHE_TTL": "86400000",
    "PUBLIC_SQUIDEX_ASSETS": "/api/assets/oxossi-malta/",
    "PUBLIC_SQUIDEX_ENVIRONMENT": "https://cloud.squidex.io",
    "SITE_URL": "https://capoeiramalta.com",
    "SQUIDEX_APP_NAME": "oxossi-malta",
    "SQUIDEX_CLIENT_ID": "oxossi-malta:read-only"
  }
}
